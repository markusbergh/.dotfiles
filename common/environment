#
# Common Environment Variables
# Shared between bash and zsh
# ------------------------------------------------------------

# Paths
export PATH="$PATH:/opt/local/bin:/usr/local/sbin"

# Default blocksize for ls, df, du
export BLOCKSIZE=1k

# Default editor
export EDITOR=vim

# Colors for ls
export CLICOLOR=1
export LSCOLORS="HxFxcxdxCxegedabagacad"

# GPG
export GPG_TTY=$(tty)
