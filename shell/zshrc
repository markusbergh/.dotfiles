#   -------------------------------------------------------------
#   .zshrc
#
#   Zsh configuration - sources common files shared with bash
#   -------------------------------------------------------------

export DOTFILES="$HOME/.dotfiles"

#
#   Homebrew (first, so its paths and completions exist before compinit)
#   -------------------------------------------------------------
eval "$(/opt/homebrew/bin/brew shellenv)"

#
#   Common configuration (shared with bash)
#   -------------------------------------------------------------
source "$DOTFILES/shell/environment"
source "$DOTFILES/shell/aliases"
source "$DOTFILES/shell/git_prompt"

#
#   Completion
#   -------------------------------------------------------------
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

#
#   Machine-specific configuration (gitignored)
#   -------------------------------------------------------------
[[ -f "$DOTFILES/shell/work" ]] && source "$DOTFILES/shell/work"

#
#   iTerm shell integration
#   -------------------------------------------------------------
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

#
#   Zsh plugins
#   -------------------------------------------------------------
if [ -f ~/.zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  source ~/.zsh_plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"
  ZSH_AUTOSUGGEST_STRATEGY=(completion history)
fi

if [ -f ~/.zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
  source ~/.zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

#
#   Version control info for prompt
#   -------------------------------------------------------------
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '(%b)'

#
#   PATH Configuration
#   -------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

#
#   Git prompt with status indicator (zsh version)
#   -------------------------------------------------------------
_git_prompt() {
  local ansi="$(_git_status_ansi)"
  if [ -n "$ansi" ]; then
    echo -n '\e[0;37;'"$ansi"';1m \e[0m '
  fi
}

#
#   Prompt
#   -------------------------------------------------------------
setopt PROMPT_SUBST
NEWLINE=$'\n'
PROMPT='╭─`_git_prompt`%F{white}%*%f %F{87}%n%f@%F{63}%m%f %F{yellow}%~%f %F{13}${vcs_info_msg_0_}%f${NEWLINE}╰─$ '
