#   -------------------------------------------------------------
#   .bash_profile
#
#   Bash configuration - sources common files shared with zsh
#   -------------------------------------------------------------

export DOTFILES="$HOME/.dotfiles"

#
#   Homebrew (first, so everything below can find brew-installed tools)
#   -------------------------------------------------------------
eval "$(/opt/homebrew/bin/brew shellenv)"

#
#   Common configuration (shared with zsh)
#   -------------------------------------------------------------
source "$DOTFILES/shell/environment"
source "$DOTFILES/shell/aliases"
source "$DOTFILES/shell/git_prompt"

#
#   Machine-specific configuration (gitignored)
#   -------------------------------------------------------------
[[ -f "$DOTFILES/shell/work" ]] && source "$DOTFILES/shell/work"

#
#   Bash auto-completion (brew install bash-completion@2)
#   -------------------------------------------------------------
[[ -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]] && . "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"

#
#   Git auto-completion (Homebrew git if installed, otherwise Xcode's git)
#   -------------------------------------------------------------
for git_completion in \
  "$HOMEBREW_PREFIX/etc/bash_completion.d/git-completion.bash" \
  "$(xcode-select -p 2>/dev/null)/usr/share/git-core/git-completion.bash"
do
  if [ -f "$git_completion" ]; then
    source "$git_completion"
    __git_complete g __git_main
    break
  fi
done
unset git_completion

#
#   Avoid successive duplicates in bash command history
#   ------------------------------------------------------------
export HISTCONTROL=ignoredups

#
#   Silence macOS bash deprecation warning
#   ------------------------------------------------------------
export BASH_SILENCE_DEPRECATION_WARNING=1

#
#   iTerm shell integration
#   ------------------------------------------------------------
test -e "${HOME}/.iterm2_shell_integration.bash" && source "${HOME}/.iterm2_shell_integration.bash"

#
#   Cargo (Rust)
#   ------------------------------------------------------------
. "$HOME/.cargo/env"

#   Prompt colors
#   ------------------------------------------------------------
GRAY="\[\e[0;00m\]"
WHITE='\[\e[0;37m\]'
YELLOW="\[\e[0;33m\]"
LIGHT_BLUE="\[\e[0;94m\]"
LIGHT_CYAN="\[\e[0;96m\]"
LIGHT_MAGENTA="\[\e[0;95m\]"

#   Git branch in prompt
#   ------------------------------------------------------------
parse_git_branch() {
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}

#   Git prompt with status indicator
#   ------------------------------------------------------------
_git_prompt() {
  local ansi="$(_git_status_ansi)"
  if [ -n "$ansi" ]; then
    echo -n '\[\e[0;37;'"$ansi"';1m\] \[\e[0m\] '
  fi
}

#   Set prompt
#   ------------------------------------------------------------
_prompt_command() {
    PS1="╭─`_git_prompt`${WHITE}\t ${LIGHT_CYAN}\u${GRAY}@${LIGHT_BLUE}\h ${YELLOW}\w${LIGHT_MAGENTA}\$(parse_git_branch)${GRAY}\n╰─$ "
}
PROMPT_COMMAND=_prompt_command
