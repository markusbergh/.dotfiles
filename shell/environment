#
# Common Environment Variables
# Shared between bash and zsh
# ------------------------------------------------------------

# Paths (scripts in ~/.dotfiles/bin, e.g. xcoderun)
export PATH="$PATH:${DOTFILES:-$HOME/.dotfiles}/bin"

# Default blocksize for ls, df, du
export BLOCKSIZE=1k

# Default editor
export EDITOR=vim

# Colors for ls
export CLICOLOR=1
export LSCOLORS="HxFxcxdxCxegedabagacad"

# GPG
export GPG_TTY=$(tty)
