#
# Common Aliases
# Shared between bash and zsh
# ------------------------------------------------------------

# Reload shell (works for both bash and zsh)
alias reload='exec $SHELL -l'

# Colors for ls
alias ls="ls -G"
alias ll='ls -FGlAhp'

# Vim
alias vi="vim"
alias sudo="sudo "
alias vi-git-status='vi -p `git status --porcelain | cut -c4-`'

# Remove .DS_Store recursively
alias rm_dstore='find . -name ".DS_Store" -type f -delete'

# Git
alias g='git'
alias gp='git push'
alias gb='git branch'
alias gc='git checkout'
alias gm='git commit -m'
alias gma='git commit -am'
alias gd='git diff'
alias gra='git remote add'
alias grr='git remote rm'
alias gpu='git pull'
alias gl='git log'
alias ga='git add'
alias gs='git status'

# SSH Key (macOS keychain)
alias ssh-add='ssh-add --apple-use-keychain'

# Searching
alias quickfind='find . -name '
ff () { find . -name "*$1*" -ls ; }

# Networking
alias myip='curl -s -w "\n" http://whatismyip.akamai.com/'
alias mylocalip="ifconfig | grep -Eo 'inet (addr:)?([0-9]*\.){3}[0-9]*' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '127.0.0.1'"
alias ipen0='ipconfig getpacket en0'
